{
  "name": "kamosu-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "css": "tailwindcss -i ./src/app.css -o \"${CSS_OUT:-../assets/app.css}\"",
    "icons": "node ./generate-icons.mjs",
    "client": "node ./generate-client.mjs",
    "manifest": "node ./generate-manifest.mjs"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.18.2",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "jsdom": "^30.0.1",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "description": "Kamosu's interface: one Svelte app, one generated stylesheet, one typed client."
}
